# Flywindow — normal online production defaults. Node reads .env automatically.
# No API key is required by the configured public endpoints; usage terms still apply.
PORT=3000
HOST=0.0.0.0
# Docker binds to loopback by default. Use your reverse proxy, or Caddy below.
BIND_ADDRESS=127.0.0.1
CONTACT_EMAIL=

# For personal/non-commercial use within the provider's limits.
OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_PROFILE_URL=https://api.open-meteo.com/v1/gfs
GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
OPEN_METEO_API_KEY=
# For commercial hosting, use the customer URLs/key supplied by your subscription.
# Example weather host: customer-api.open-meteo.com; confirm all contracted endpoints.

ENABLE_PGEARTH=true
PGEARTH_URL=https://paraglidingearth.com/api/getAroundLatLngSites.php
ENABLE_OSM_FALLBACK=true
OVERPASS_URL=https://overpass-api.de/api/interpreter
# The public FFVL JSON URLs currently return an API-key notice, not feed data.
# Enable only after arranging authorized access and configuring working feed URLs.
ENABLE_FFVL=false
FFVL_STATIONS_URL=https://data.ffvl.fr/json/balises.json
FFVL_READINGS_URL=https://data.ffvl.fr/json/relevesmeteo.json
# Leave blank unless FFVL confirms the timezone of offset-free timestamps.
# Such readings remain explicitly time-unverified when this is blank.
FFVL_TIMESTAMP_TIMEZONE=

TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
TILE_ATTRIBUTION="© OpenStreetMap contributors"
TILE_ATTRIBUTION_URL=https://www.openstreetmap.org/copyright

MAX_SITES=60
UPSTREAM_TIMEOUT_MS=18000
FORECAST_CACHE_SECONDS=1200
CACHE_DIR=data/cache
CUSTOM_SITES_FILE=data/sites.geojson
REQUESTS_PER_MINUTE=180
# This counts HTTP requests, NOT provider-weighted billing/quota units.
UPSTREAM_HOURLY_REQUEST_BUDGET=240

# Recommended for a private server: set BOTH and use HTTPS.
# Quote passwords containing # or spaces. Never commit this file.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Only needed for the supplied Docker+Caddy HTTPS deployment.
DOMAIN=
ACME_EMAIL=

# Never enable test fixtures or loopback upstream exceptions in production.
TEST_DATA=false
ALLOW_LOCAL_TEST_UPSTREAMS=false
