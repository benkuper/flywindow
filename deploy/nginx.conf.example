# Example: adapt the domain and your existing TLS certificate paths.
# Mount the application at / on a dedicated hostname, not a URL subdirectory.
server {
    listen 443 ssl;
    server_name fly.example.com;
    ssl_certificate /etc/letsencrypt/live/fly.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/fly.example.com/privkey.pem;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 90s;
    }
}
server {
    listen 80;
    server_name fly.example.com;
    return 301 https://$host$request_uri;
}
